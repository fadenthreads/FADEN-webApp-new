FROM node:22-alpine AS dependencies
WORKDIR /app
COPY package.json package-lock.json* ./
COPY apps/marketplace/package.json ./apps/marketplace/package.json
COPY apps/studio/package.json ./apps/studio/package.json
COPY apps/admin/package.json ./apps/admin/package.json
COPY packages/ui/package.json ./packages/ui/package.json
COPY packages/env/package.json ./packages/env/package.json
COPY packages/supabase/package.json ./packages/supabase/package.json
COPY packages/auth/package.json ./packages/auth/package.json
RUN npm ci

FROM dependencies AS builder
ARG APP_NAME=marketplace
ARG NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
ARG NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=build-only-placeholder
ARG NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
ENV NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL}
ENV NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=${NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY}
ENV NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=${NEXT_PUBLIC_GOOGLE_AUTH_ENABLED}
COPY . .
RUN npm run build --workspace=@faden/${APP_NAME}

FROM node:22-alpine AS runner
ARG APP_NAME=marketplace
ENV NODE_ENV=production
ENV APP_NAME=${APP_NAME}
WORKDIR /app
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=builder --chown=nextjs:nodejs /app/apps/${APP_NAME}/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/${APP_NAME}/.next/static ./apps/${APP_NAME}/.next/static
USER nextjs
EXPOSE 3000
CMD ["sh", "-c", "node apps/$APP_NAME/server.js"]
