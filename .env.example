# Browser-safe Supabase settings
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_PHONE_AUTH_ENABLED=false

# Server-only settings. Never expose these to browser code.
SUPABASE_SECRET_KEY=replace-with-local-secret-key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
GEOAPIFY_API_KEY=replace-with-server-only-key

# Studio server only. Leave both flags false until Shiprocket is connected and verified.
SHIPROCKET_API_EMAIL=replace-with-dedicated-api-user
SHIPROCKET_API_PASSWORD=replace-with-api-user-password
SHIPROCKET_PICKUP_LOCATION=replace-with-dashboard-pickup-name
SHIPROCKET_PICKUP_POSTCODE=110001
SHIPROCKET_WEBHOOK_SECRET=replace-with-independent-random-secret
SHIPROCKET_API_ENABLED=false
SHIPROCKET_LIVE_BOOKING_ENABLED=false

# Marketplace + Studio servers. Private video rooms remain off until Daily is configured.
# The API key is server-only. Never prefix it with NEXT_PUBLIC_.
DAILY_API_KEY=replace-with-server-only-api-key
DAILY_API_BASE_URL=https://api.daily.co/v1
DAILY_API_ENABLED=false
DAILY_LIVE_ROOMS_ENABLED=false

# Marketplace server only. Live Razorpay keys are deliberately rejected.
# Add real TEST values only to apps/marketplace/.env.local (never commit them).
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-test-key-secret
# Separate secret configured on the Razorpay TEST webhook; not the API key secret.
RAZORPAY_WEBHOOK_SECRET=replace-with-test-webhook-secret

# App metadata
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_MARKETPLACE_URL=http://localhost:3000
NEXT_PUBLIC_STUDIO_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
